.pager-message{border-left:3px solid #d9b551;padding:.85rem 1rem;margin-bottom:1rem;border-radius:0 .7rem .7rem 0;background:#fff8e9}.pager [hidden]{display:none!important}.pager-message h3{font-size:1rem;font-weight:700;color:var(--pwa-accent-dark);margin:0 0 .5rem}.pager-message p{margin:0;white-space:pre-wrap;overflow-wrap:anywhere}.pager-message small{display:inline-block;color:#7c6b55;margin-top:.5rem}[data-pager-pair]{display:inline-flex;align-items:center;gap:.45rem}.pager-bluetooth-icon{flex-shrink:0}.pager-bluetooth-debug{margin-top:1rem}.pager-bluetooth-debug summary{cursor:pointer}.pager-bluetooth-debug pre{max-height:20rem;overflow:auto;white-space:pre-wrap;overflow-wrap:anywhere;font-size:.8rem}.pager-controls{display:flex;flex-wrap:wrap;align-items:center;gap:.4rem}.pager .pager-controls button,.pager .pager-controls select{min-height:2.5rem;padding:.4rem .65rem;font-size:.85rem}.pager .pager-controls button{display:inline-flex;align-items:center;gap:.3rem}.pager .pager-controls button[aria-pressed=true]{box-shadow:inset 0 0 0 2px var(--pwa-accent-dark)}.pager-interval{display:inline-flex;align-items:center;gap:.3rem;margin:0;font-size:.8rem}.pager-connection-settings{margin-top:.5rem}.pager-connection-settings summary{cursor:pointer}[data-pager-socket-url]{display:block;width:100%;box-sizing:border-box;margin-top:.3rem}.pager .pager-controls select{width:auto;margin:0}:root{--color-disabled: #b0b0b0;--color-primary: rgb(2, 189, 2);--color-white: #ffffff;--bg-color-primary: #202125}button{padding:10px 20px;font-size:16px;border:none;background-color:var(--color-primary);color:var(--color-white);border-radius:5px;cursor:pointer}button:disabled{background-color:var(--color-disabled);cursor:not-allowed}mark{padding:0}.search--hidden{opacity:0}.search--highlight{color:var(--pf-accent)}button{background:rgb(255,0,0)}[data-todo-progress]{width:100%;height:.8rem;accent-color:var(--pwa-accent);margin-bottom:1rem}.checklist-task{display:flex;gap:.85rem;align-items:center;padding:1rem 0;border-bottom:1px solid #eee5d7;cursor:pointer}.checklist-task input{width:1.15rem;height:1.15rem;flex-shrink:0;accent-color:var(--pwa-accent)}.checklist-task strong,.checklist-task small{display:block}.checklist-task small{color:#806e60;margin-top:.25rem}.checklist-task:has(input:checked) strong{color:#887665;text-decoration:line-through}.demo-reminder{position:fixed;right:1rem;bottom:1rem;z-index:1050;width:min(23rem,calc(100vw - 2rem));padding:1rem 1.25rem;background:#fffaf0;border:1px solid #dfc57e;border-radius:1rem;box-shadow:0 12px 35px #56342426;color:#5b4034}.demo-reminder[hidden]{display:none}.demo-reminder>div{display:flex;justify-content:space-between;align-items:center}.demo-reminder button{border:0;border-radius:50%;background:#f6e8d6;color:var(--pwa-accent-dark);width:2rem;height:2rem}.demo-reminder p{margin:.75rem 0}.demo-reminder a{color:var(--pwa-accent)}.preparedness-card{max-width:52rem;margin:2rem auto;padding:clamp(1rem,3vw,1.75rem);border:1px solid #eaddc6;border-radius:1.25rem;background:linear-gradient(145deg,#fff,#fffaf0);color:#57443a}.preparedness-heading{display:flex;flex-wrap:wrap;align-items:center;justify-content:space-between;gap:.75rem;margin-bottom:1rem}.preparedness-heading h2{margin:.4rem 0 0;font-size:1.5rem;font-weight:750;color:#553a33}.preparedness-caption{font-size:.85rem;color:#806e60;margin-block:.75rem}.preparedness-pill{padding:.4rem .75rem;border-radius:2rem;background:#fff0c9;color:#79591d;font-size:.8rem}.preparedness-actions{display:flex;flex-wrap:wrap;gap:.75rem;align-items:center}.preparedness-card button{padding:.65rem .9rem;background:#fff1d3;border:1px solid #e2c78c;border-radius:.7rem;color:var(--pwa-accent-dark);font:inherit;font-size:.85rem}.preparedness-card button:disabled{opacity:.55}.preparedness-card a{color:var(--pwa-accent);font-size:.85rem}.preparedness-card :focus-visible{outline:2px solid var(--pwa-accent);outline-offset:3px}.preparedness-card select{display:block;width:100%;padding:.7rem;margin:.5rem 0 1rem;border:1px solid #e4d6c3;border-radius:.7rem;background:white;color:#57443a}.tracking-details{margin-top:1rem;font-size:.85rem}.tracking-details summary{cursor:pointer}.tracking-details p{margin-block:.75rem}:root{--pwa-accent: #9b3434;--pwa-accent-end: #8d3039;--pwa-accent-dark: #6e3030;--pwa-accent-soft: #fbe9e5;--pwa-accent-shadow: #a9363620;--pwa-accent-hover-shadow: #a9363630}:root[data-preparedness=complete]{--pwa-accent: #24734e;--pwa-accent-end: #195b3d;--pwa-accent-dark: #24543c;--pwa-accent-soft: #e5f3e9;--pwa-accent-shadow: #24734e20;--pwa-accent-hover-shadow: #24734e30}.pwa-logo{width:fit-content;margin:2rem auto 1.5rem;padding:1.5rem 2rem;border:1px solid #eee8dc;border-radius:1.5rem;background:#fff;box-shadow:0 10px 28px #6747310a}.pwa-logo img{display:block;width:240px;max-width:100%;height:auto}.pwa-status{position:sticky;top:0;z-index:1020;display:flex;flex-wrap:wrap;align-items:center;justify-content:space-between;gap:.75rem;padding:1rem clamp(1rem,4vw,3rem);background:linear-gradient(120deg,#f3a39ff5,#fc3a04f5);border-bottom:1px solid #edddb9;backdrop-filter:blur(16px);color:#503b33;box-shadow:0 6px 24px #78512912}:root[data-preparedness=complete] .pwa-status .pwa-brand{color:#fff}:root[data-preparedness=complete] .pwa-status{background:linear-gradient(120deg,#24734ef5,#195b3df5)}.pwa-brand{display:flex;gap:.6rem;align-items:center;color:var(--pwa-accent-dark);font-size:1.15rem;font-weight:800;text-decoration:none}.pwa-brand:hover,.pwa-brand-suffix{color:var(--pwa-accent)}.pwa-indicators{display:flex;flex-wrap:wrap;gap:.5rem;align-items:center}.pwa-chip,.pwa-update{padding:.4rem .75rem;border:1px solid #e8d9bc;border-radius:2rem;background:#ffffffb3;font-size:.78rem;font-weight:600;white-space:nowrap}.pwa-status [data-pwa-network]{color:#75602a}.pwa-status [data-offline=true]{color:var(--pwa-accent);background:var(--pwa-accent-soft)}.pwa-status .pwa-update{background:var(--pwa-accent);color:#fff9e9;cursor:pointer}.pwa-status [hidden]{display:none}.pwa-status :focus-visible{outline:3px solid var(--pwa-accent);outline-offset:3px}@media (max-width: 480px){.pwa-status{justify-content:center}.pwa-chip{padding:.35rem .6rem}}.pwa-todo-link{color:var(--pwa-accent);text-decoration:none}.pwa-cache-reset{color:var(--pwa-accent);cursor:pointer}.pwa-cache-reset:disabled{opacity:.5;cursor:not-allowed}.pwa-install{text-align:center;margin:2rem auto}.pwa-install .pwa-install-button{border:0;border-radius:2rem;background:linear-gradient(120deg,var(--pwa-accent),var(--pwa-accent-end));padding:.85rem 1.6rem;color:#fff;font-weight:700;box-shadow:0 6px 18px var(--pwa-accent-shadow);transition:transform .15s ease,box-shadow .15s ease}.pwa-install-button:hover{transform:translateY(-2px);box-shadow:0 10px 22px var(--pwa-accent-hover-shadow)}.pwa-install-button:disabled{opacity:.65;transform:none}.pwa-install-button:focus-visible{outline:3px solid #ca9a27;outline-offset:4px}.pwa-install-help{font-size:.8rem;color:#746359;margin-top:.75rem}.pwa-install-help:empty{display:none}@media (prefers-reduced-motion: reduce){.pwa-install .pwa-install-button{transition:none;transform:none}}.pwa-install[hidden],.pwa-install [hidden]{display:none}.pwa-documents{max-width:52rem;margin:2.5rem auto 4rem}.pwa-documents-heading{display:flex;flex-wrap:wrap;gap:1rem;align-items:center;justify-content:space-between;margin-bottom:1.5rem}.pwa-eyebrow{color:#82705d;font-size:.7rem;font-weight:800;letter-spacing:.16em}.pwa-documents h1{font-size:clamp(1.6rem,4vw,2.25rem);font-weight:800;color:#463632;margin:.5rem 0 0;letter-spacing:-.045em}.pwa-documents h1 span{color:var(--pwa-accent)}.pwa-document-count,.pwa-document-badge{font-size:.75rem;font-weight:600;background:#fff2cc;color:#79591d;padding:.4rem .75rem;border-radius:2rem;white-space:nowrap}.pwa-documents article{display:flex;flex-wrap:wrap;align-items:center;justify-content:space-between;gap:1rem;margin-block:1rem;padding:clamp(1rem,3vw,1.75rem);border:1px solid #e