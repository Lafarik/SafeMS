er-radius:.7rem;padding:.65rem .9rem;background:#fffaf0;color:#6b5548;font:inherit;font-size:.85rem}.document-tabs [aria-selected=true]{background:#fff0c2;border-color:#cc9c35;color:var(--pwa-accent-dark);font-weight:700}.document-tabs [role=tab]:focus-visible,.document-tab-panel:focus-visible{outline:2px solid var(--pwa-accent);outline-offset:3px}.document-tab-panel[hidden]{display:none}
